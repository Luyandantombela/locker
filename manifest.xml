<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- App Identity -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Cell Protector</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <!-- Display info -->
  <DisplayName DefaultValue="Cell Protector"/>
  <Description DefaultValue="Quickly protect only the cells you choose — by selection or by formula. Includes optional password protection and editable-cell highlighting with color restoration."/>

  <!-- Icons — replace these paths with real icon files if desired -->
  <IconUrl DefaultValue="https://luyandantombela.github.io/locker/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://luyandantombela.github.io/locker/assets/icon-64.png"/>

  <!-- Support URL -->
  <SupportUrl DefaultValue="https://github.com/Luyandantombela/locker"/>

  <!-- App domains -->
  <AppDomains>
    <AppDomain>https://luyandantombela.github.io</AppDomain>
  </AppDomains>

  <!-- Hosts -->
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <!-- Default settings -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://luyandantombela.github.io/locker/cell-protector/index.html"/>
  </DefaultSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- Version overrides for newer runtime features -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16"  DefaultValue="https://luyandantombela.github.io/locker/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32"  DefaultValue="https://luyandantombela.github.io/locker/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80"  DefaultValue="https://luyandantombela.github.io/locker/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl"  DefaultValue="https://github.com/Luyandantombela/locker"/>
        <bt:Url id="Commands.Url"             DefaultValue="https://luyandantombela.github.io/locker/cell-protector/index.html"/>
        <bt:Url id="Taskpane.Url"             DefaultValue="https://luyandantombela.github.io/locker/cell-protector/index.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title"       DefaultValue="Get started with Cell Protector"/>
        <bt:String id="CommandsGroup.Label"    DefaultValue="Cell Protector"/>
        <bt:String id="TaskpaneButton.Label"   DefaultValue="Open Cell Protector"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Protect only the cells you choose — by selection or by formula."/>
        <bt:String id="TaskpaneButton.Tooltip"  DefaultValue="Open the Cell Protector taskpane to lock cells by selection or formula."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
